# Frontend environment (copy to .env for local dev; set the same two in Vercel).
# These are PUBLIC by design: the anon key only works within the database
# security rules. Never add a secret here — anything prefixed VITE_ is shipped
# to every browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Legacy anon key (eyJ...) or the new publishable key (sb_publishable_...)
VITE_SUPABASE_ANON_KEY=

# The Razorpay key, key secret, webhook secret and Gemini key are NOT set here.
# They live in Supabase → Edge Functions → Secrets. See supabase/functions/.env.example.
