# Server secrets for the Edge Functions.
# Set them in Supabase Dashboard → Edge Functions → Secrets (Add new secret),
# or with the CLI:  npx supabase secrets set --env-file supabase/functions/.env
# Never commit the real file, never paste these into the frontend.

# Razorpay — Dashboard → Account & Settings → API Keys.
# Test mode now; to go live, replace these three and nothing else changes.
RAZORPAY_KEY_ID=rzp_test_TsVE250GMrScF8
RAZORPAY_KEY_SECRET=
# Razorpay → Settings → Webhooks → the secret you type when adding the webhook
RAZORPAY_WEBHOOK_SECRET=

# Google AI Studio → Get API key. Create a fresh key (the old one was exposed).
GEMINI_API_KEY=
# Optional. Default: gemini-3.5-flash-lite. Use gemini-2.5-flash if your key's tier doesn't have it.
GEMINI_MODEL=

# Sites allowed to call the functions from a browser (comma-separated, no spaces needed)
ALLOWED_ORIGINS=https://vantaris.finance,https://www.vantaris.finance,http://localhost:5173

# Provided automatically by Supabase, do not set: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY / SUPABASE_SECRET_KEYS
