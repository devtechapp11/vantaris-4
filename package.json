{
  "name": "vantaris",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:preview": "vite build --mode demo --outDir dist-preview",
    "preview": "vite preview",
    "lint": "oxlint src",
    "sql": "node scripts/build-sql.mjs",
    "test:sql": "bash supabase/tests/run.sh && bash supabase/tests/race.sh",
    "test:functions": "VANTARIS_TEST=1 npx -y deno@2 test --node-modules-dir=none --allow-env --allow-net --allow-read supabase/functions/tests/",
    "icons": "node scripts/make-icons.mjs",
    "mascot": "node scripts/mascot.mjs",
    "og": "node scripts/make-og.mjs",
    "typecheck": "tsc --noEmit",
    "check:palette": "node scripts/check-palette.mjs",
    "prebuild": "node scripts/check-palette.mjs",
    "test": "node scripts/sync-shared.mjs --check && node --test src/lib/finance/*.test.ts src/pedagogy/*.test.ts",
    "postbuild": "node scripts/check-dist.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "build:qa": "QA_BASE=/ vite build --mode demo --outDir dist-qa",
    "shots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@supabase/supabase-js": "^2.118.0",
    "gsap": "^3.15.1",
    "lenis": "^1.3.11",
    "lucide-react": "^1.61.0",
    "maath": "^0.10.8",
    "motion": "^12.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.27.7",
    "oxlint": "^1.88.0",
    "playwright": "^1.65.0",
    "typescript": "~5.9",
    "vite": "^8.3.4"
  }
}
